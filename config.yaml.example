server:
  host: "0.0.0.0"
  port: 55555

model:  
  path: "/home/ai-model/LLM/model/gemma-4-E4B-it-qat-mobile-ct"
  dtype: "bfloat16"
  gpu_memory_utilization: 0.45
  trust_remote_code: true

inference:
  # vLLM API fallback defaults (used when client does not specify)
  default_max_tokens: 1024
  default_temperature: 0.7
  seed : 5555

sentiment:
  sentence_length_limit : true
  max_string_length : 500
  only_sentiment_output : true

result_dir: "/home/ai-model/sentiment_by_selfhost_LLM/result"